{
  "name": "Math 2001 (Lean 4)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"]
    }
  },
  "updateContentCommand": "lake exe cache get && lake build Library && lake build AutograderLib",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/scripts"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
